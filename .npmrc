# 国内加速（淘宝源最稳定）
registry=https://registry.npmmirror.com/

# 现代推荐：替代 shamefully-hoist=true 的精细写法
# 只提升真正需要被全局访问的包，其他全部严格隔离
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=@types/*
public-hoist-pattern[]=*tailwindcss*
public-hoist-pattern[]=*postcss*
public-hoist-pattern[]=*autoprefixer*

# Next.js 19 + React 19 必须提升的
public-hoist-pattern[]=*react*
public-hoist-pattern[]=*react-dom*

# 你项目里必须提升的（避免各种 import 找不到错误）
public-hoist-pattern[]=*lucide-react*
public-hoist-pattern[]=*class-variance-authority*
public-hoist-pattern[]=*clsx*
public-hoist-pattern[]=*tailwind-merge*
public-hoist-pattern[]=*framer-motion*
public-hoist-pattern[]=*howler*
public-hoist-pattern[]=*zustand*

# 可选：进一步减少 node_modules 体积（推荐）
node-linker=hoisted

# 国内生态基本都得关
strict-peer-dependencies=false

# 可选：锁 pnpm 版本（防止团队成员版本差异导致 hoist 报错）
# engine-strict=true