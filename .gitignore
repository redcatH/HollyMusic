# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# lx
/lx-music-desktop-master
/lib/generated/prisma
/.cache
/config/users.json
*.mp3

# prisma
/prisma/data/
/prisma_data/
/cache_data/
/app_logs/
/prisma/data/
# 数据库文件（含异常路径 prisma/prisma/data/ 本地落盘产物）及 SQLite 临时文件
*.db
*.db-journal
*.db-wal
*.db-shm
/prisma/prisma/

!prisma/migrations/.gitkeep
*/prisma/data/**.db

/config/music-sources.json

# custom sources (local only, not for commit)
/custom-sources/

# opencode workspace
/.omo/

# runtime audio cache & local test files
/data/
/test/

# Next.js dev 日志 & GUI 测试截图（本地产物，不提交）
.next-dev.log
/gui-test-screenshots/

# AI / 编辑器工具产物 (本地, 不提交)
.zcode/
.playwright-mcp/
.sisyphus/
.cursor/
.windsurf/
.continue/
.aider*
.codeium/
.gemini/
.copilot/

# Python 编译/缓存
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
