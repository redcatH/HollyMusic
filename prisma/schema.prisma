// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model MusicInfo {
  id        Int      @id @default(autoincrement())
  source    String
  songmid   String
  data      String
  checksum  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Denormalized/searchable fields
  name           String?   // 歌曲名
  singer         String?   // 歌手/艺人
  albumId        String?   // 专辑 id
  albumName      String?   // 专辑名
  img            String?   // 封面 URL/路径
  durationSeconds Int?     // 时长（秒）

  // Source-specific identifiers
  songId         String?
  albumMid       String?
  strMediaMid    String?
  hash           String?
  copyrightId    String?

  // Structured JSON fields (kept for flexibility) - store as JSON text for SQLite
  typesJson      String?
  typesMapJson   String?
  typeUrlJson    String?

  // Lyrics / resource URLs
  lrc            String?
  lrcUrl         String?
  mrcUrl         String?
  trcUrl         String?

  playlistEntries PlaylistEntry[]

  @@unique([source, songmid])
  @@index([songmid])
  @@index([name])
  @@index([singer])
  @@index([albumId])
  @@index([albumName])
  @@index([songId])
}

model User {
  id             Int      @id @default(autoincrement())
  username       String   @unique
  subsonicSecret String?  // optional plain secret for t verification (md5(secret+s))
  lastLogin      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  favorites Favorite[]
  playlists Playlist[]
  playlistAllowedUsers PlaylistAllowedUser[]
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  itemType  String   // 'song' | 'album' | 'artist'
  itemId    String   // the id value as passed by client (raw song id / album id / artist id)
  source    String?  // optional source/origin of the item (may be null)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemId, source])
  @@index([itemId])
}

model Playlist {
  id             Int      @id @default(autoincrement())
  name           String
  username       String
  comment        String?
  isPublic       Boolean  @map("public") @default(false)
  songCount      Int      @default(0)
  duration       Int?     // seconds
  createdAt      DateTime @map("created") @default(now())
  changedAt      DateTime @map("changed") @updatedAt
  owner          String?
  coverArt       String?

  user           User     @relation(fields: [username], references: [username], onDelete: Cascade)
  entries        PlaylistEntry[]
  allowedUsers   PlaylistAllowedUser[]

  @@index([username])
  @@index([isPublic])
}

model PlaylistEntry {
  id            Int      @id @default(autoincrement())
  playlistId    Int
  musicInfoId   Int?
  songmid       String?
  position      Int
  addedBy       String?
  addedAt       DateTime @default(now())
  snapshotJson  String?
  playCount     Int      @default(0)
  lastPlayed    DateTime?

  playlist      Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  musicInfo     MusicInfo? @relation(fields: [musicInfoId], references: [id], onDelete: SetNull)

  @@unique([playlistId, position])
  @@index([playlistId])
  @@index([musicInfoId])
  @@index([songmid])
}

model PlaylistAllowedUser {
  id         Int      @id @default(autoincrement())
  playlistId Int
  username   String

  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [username], references: [username], onDelete: Cascade)

  @@unique([playlistId, username])
  @@index([username])
}

model PlayHistory {
  id          Int      @id @default(autoincrement())
  playlistId  Int?
  entryId     Int?
  musicInfoId Int?
  songmid     String?
  username    String?
  playedAt    DateTime @default(now())
  clientIp    String?
  userAgent   String?

  // 同一用户同一首歌只保留一条（再次播放更新 playedAt 移到顶部，商业项目主流做法）
  @@unique([username, songmid])
  @@index([playedAt])
  @@index([username])
  @@index([playlistId])
}

/// 服务端音频磁盘缓存索引。
/// 上游音源 CDN 普遍不支持 Range 请求，无法直接 seek；
/// 此表记录已落盘（或正在落盘）的音频字节流，配合 fs.createReadStream
/// 为 <audio> 提供标准 206 Partial Content 响应，实现多用户共享 + seek。
model AudioCache {
  /// 主键
  id          Int      @id @default(autoincrement())
  /// 缓存键：`${source}:${songmid}:${quality}`，与 urlCache 键一致
  cacheKey    String   @unique
  /// 相对缓存根目录的文件路径（两级分片：ab/abcdef.mp3）
  filePath    String
  /// 上游声明的完整字节数（无 content-length 时为 null）
  size        Int?
  /// 已落盘字节数（边下边播水位线依据）
  downloadedBytes Int   @default(0)
  /// 'downloading' | 'complete' | 'partial'（partial = 上游中断/进程重启，无法续传）
  status      String   @default("downloading")
  /// MIME，用于 serve 时 Content-Type
  contentType String?
  /// 音质（缓存键的一部分冗余，便于按音质清理）
  quality     String
  /// 对外歌曲 uid（`source-存储songmid`），用于关联与排查
  uid         String
  /// 最近一次被读取访问的时间（LRU 淘汰依据）
  lastAccessAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([lastAccessAt])
  @@index([uid])
}
