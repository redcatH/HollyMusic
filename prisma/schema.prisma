// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model MusicInfo {
  id        Int      @id @default(autoincrement())
  source    String
  songmid   String
  data      String
  checksum  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Denormalized/searchable fields
  name           String?   // 歌曲名
  singer         String?   // 歌手/艺人
  albumId        String?   // 专辑 id
  albumName      String?   // 专辑名
  img            String?   // 封面 URL/路径
  durationSeconds Int?     // 时长（秒）

  // Source-specific identifiers
  songId         String?
  albumMid       String?
  strMediaMid    String?
  hash           String?
  copyrightId    String?

  // Structured JSON fields (kept for flexibility) - store as JSON text for SQLite
  typesJson      String?
  typesMapJson   String?
  typeUrlJson    String?

  // Lyrics / resource URLs
  lrc            String?
  lrcUrl         String?
  mrcUrl         String?
  trcUrl         String?

  playlistEntries PlaylistEntry[]

  @@unique([source, songmid])
  @@index([songmid])
  @@index([name])
  @@index([singer])
  @@index([albumId])
  @@index([albumName])
  @@index([songId])
}

model User {
  id             Int      @id @default(autoincrement())
  username       String   @unique
  subsonicSecret String?  // optional plain secret for t verification (md5(secret+s))
  lastLogin      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  favorites Favorite[]
  playlists Playlist[]
  playlistAllowedUsers PlaylistAllowedUser[]
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  itemType  String   // 'song' | 'album' | 'artist'
  itemId    String   // the id value as passed by client (raw song id / album id / artist id)
  source    String?  // optional source/origin of the item (may be null)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemId, source])
  @@index([itemId])
}

model Playlist {
  id             Int      @id @default(autoincrement())
  name           String
  username       String
  comment        String?
  isPublic       Boolean  @map("public") @default(false)
  songCount      Int      @default(0)
  duration       Int?     // seconds
  createdAt      DateTime @map("created") @default(now())
  changedAt      DateTime @map("changed") @updatedAt
  owner          String?
  coverArt       String?

  user           User     @relation(fields: [username], references: [username], onDelete: Cascade)
  entries        PlaylistEntry[]
  allowedUsers   PlaylistAllowedUser[]

  @@index([username])
  @@index([isPublic])
}

model PlaylistEntry {
  id            Int      @id @default(autoincrement())
  playlistId    Int
  musicInfoId   Int?
  songmid       String?
  position      Int
  addedBy       String?
  addedAt       DateTime @default(now())
  snapshotJson  String?
  playCount     Int      @default(0)
  lastPlayed    DateTime?

  playlist      Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  musicInfo     MusicInfo? @relation(fields: [musicInfoId], references: [id], onDelete: SetNull)

  @@unique([playlistId, position])
  @@index([playlistId])
  @@index([musicInfoId])
  @@index([songmid])
}

model PlaylistAllowedUser {
  id         Int      @id @default(autoincrement())
  playlistId Int
  username   String

  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [username], references: [username], onDelete: Cascade)

  @@unique([playlistId, username])
  @@index([username])
}

model PlayHistory {
  id          Int      @id @default(autoincrement())
  playlistId  Int?
  entryId     Int?
  musicInfoId Int?
  songmid     String?
  username    String?
  playedAt    DateTime @default(now())
  clientIp    String?
  userAgent   String?

  @@index([playedAt])
  @@index([username])
  @@index([playlistId])
}
