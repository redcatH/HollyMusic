// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model MusicInfo {
  id        Int      @id @default(autoincrement())
  source    String
  songmid   String
  data      String
  checksum  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Denormalized/searchable fields
  name           String?   // 歌曲名
  singer         String?   // 歌手/艺人
  albumId        String?   // 专辑 id
  albumName      String?   // 专辑名
  img            String?   // 封面 URL/路径
  durationSeconds Int?     // 时长（秒）

  // Source-specific identifiers
  songId         String?
  albumMid       String?
  strMediaMid    String?
  hash           String?
  copyrightId    String?

  // Structured JSON fields (kept for flexibility) - store as JSON text for SQLite
  typesJson      String?
  typesMapJson   String?
  typeUrlJson    String?

  // Lyrics / resource URLs
  lrc            String?
  lrcUrl         String?
  mrcUrl         String?
  trcUrl         String?

  @@unique([source, songmid])
  @@index([songmid])
  @@index([name])
  @@index([singer])
  @@index([albumId])
  @@index([albumName])
  @@index([songId])
}

model User {
  id             Int      @id @default(autoincrement())
  username       String   @unique
  subsonicSecret String?  // optional plain secret for t verification (md5(secret+s))
  lastLogin      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  favorites Favorite[]
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  itemType  String   // 'song' | 'album' | 'artist'
  itemId    String   // the id value as passed by client (raw song id / album id / artist id)
  source    String?  // optional source/origin of the item (may be null)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemId, source])
  @@index([itemId])
}
