{
  "name": "holly-music",
  "version": "0.1.0",
  "private": true,
  "description": "多源在线音乐聚合播放器 · 自部署 · PWA · 移动端友好",
  "license": "MIT",
  "author": "redcath <30196697+redcatH@users.noreply.github.com>",
  "homepage": "https://github.com/redcatH/HollyMusic",
  "repository": {
    "type": "git",
    "url": "https://github.com/redcatH/HollyMusic.git"
  },
  "bugs": {
    "url": "https://github.com/redcatH/HollyMusic/issues"
  },
  "keywords": [
    "music",
    "music-player",
    "self-hosted",
    "pwa",
    "subsonic",
    "nextjs",
    "react",
    "aggregate"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:web": "cd frontend && pnpm dev",
    "dev:all": "concurrently -n api,web -c blue,green \"next dev -H 0.0.0.0\" \"cd frontend && pnpm dev --host\"",
    "build": "next build",
    "build:web": "cd frontend && pnpm build",
    "build:all": "next build && cd frontend && pnpm build",
    "start": "next start",
    "lint": "eslint . --ext .js,.ts,.tsx",
    "typecheck": "pnpm -C frontend exec tsc -b && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "prisma:migrate": "prisma migrate dev",
    "analyze": "ANALYZE=true next build"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.19.0",
    "big-integer": "^1.6.52",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.19",
    "dexie": "^4.4.4",
    "framer-motion": "^11.0.8",
    "he": "^1.2.0",
    "lucide-react": "^0.577.0",
    "needle": "^3.3.1",
    "next": "16.2.12",
    "qs": "^6.15.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-use": "^17.5.0",
    "react-window": "^1.8.10",
    "tailwind-merge": "^3.6.0",
    "tunnel": "^0.0.6",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/he": "^1.2.3",
    "@types/needle": "^3.3.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-window": "^1.8.8",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.1.1",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@10.22.0+sha512.bf049efe995b28f527fd2b41ae0474ce29186f7edcb3bf545087bd61fbbebb2bf75362d1307fda09c2d288e1e499787ac12d4fcb617a974718a6051f2eee741c"
}
