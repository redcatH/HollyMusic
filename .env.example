# Database URL - 在 Docker 中使用相对路径
DATABASE_URL="file:./prisma/data/music.db"

# ============================================================================
# 音频磁盘缓存（服务端 Range 代理 + 边下边播）
# ============================================================================
# 总开关：true 时走 /api/audio 磁盘缓存（支持 seek/暂停/多用户共享）；
#         false 时 /api/audio 退化为流式透传上游（不支持 seek）
ENABLE_FILE_CACHE=true

# 磁盘配额（GB），达高水位线触发 LRU 清理
AUDIO_CACHE_QUOTA_GB=10

# 同时进行的上游下载任务数上限（保护上游与服务端内存）
AUDIO_CACHE_MAX_CONCURRENT=5

# 缓存根目录（开发默认 <cwd>/data/audio-cache；Docker 建议 /app/.cache/audio-cache）
# AUDIO_CACHE_DIR=/app/.cache/audio-cache

# LRU 水位线（0-1）：高水位触发清理，清理到低水位停止
AUDIO_CACHE_WATERMARK_HIGH=0.8
AUDIO_CACHE_WATERMARK_LOW=0.7

# seek 超过已下载部分时的等待上限（ms），超时返回 503 让前端跳下一首
AUDIO_CACHE_SEEK_TIMEOUT_MS=30000

# downloading 超过此时间视为卡死（ms，默认 30 分钟），定时扫描时清理记录+.tmp 文件
AUDIO_CACHE_STALE_DOWNLOAD_MS=1800000

# 定时扫描小时（0-23，默认 3 = 凌晨 3 点），扫描卡死下载+幽灵记录+孤儿文件
AUDIO_CACHE_SCAN_HOUR=3

# Job 最大生命周期（ms，默认 5 分钟），超时自动 abort 释放信号量
AUDIO_CACHE_JOB_MAX_LIFETIME_MS=300000

# 等待上游响应头超时（ms，默认 20 秒），超时返回 503 让前端跳歌
AUDIO_CACHE_READINESS_TIMEOUT_MS=20000

# ============================================================================
# 鉴权密钥（生产环境必填！）
# ============================================================================
# Web 登录签名密钥（HMAC-SHA256），用于签名 holly_user/cookie
# 缺失时服务会告警并使用不安全的 fallback（仅限开发环境）
# 生成方式：openssl rand -hex 32  或  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=请替换为至少32位的随机字符串

# ============================================================================
# AI 功能（管理员 AI 推荐任务 + 用户 AI 协助建歌单）
# ============================================================================
# OpenAI 兼容 API key。
# - 管理员「AI 推荐任务」：前端未填 key 时回退到此
# - 用户「AI 协助建歌单」：强制使用此服务端 key（不向用户暴露）
# 缺失时：管理员任务需在前端填 key；用户 AI 建歌单不可用（提示未配置）
OPENAI_API_KEY=

# 可选：OpenAI 兼容接口地址，默认 https://api.openai.com/v1
# 可指向 DeepSeek / 通义 / 本地 LMDeploy 等 OpenAI 兼容服务
# OPENAI_BASE_URL=https://api.openai.com/v1

# 可选：模型名，默认 gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini

# 其他环境变量可在这里添加
# 例如：
# NODE_ENV=production
# LOG_LEVEL=info
